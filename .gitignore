node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# bun.lock is the authoritative lockfile for this project; don't let a
# stray `npm install` introduce a second, competing one.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Brand + example media: folder structure tracked, actual files local-only
/brand/photos/*
!/brand/photos/.gitkeep
/brand/videos/*
!/brand/videos/.gitkeep

/examples/web-app/*
!/examples/web-app/.gitkeep
!/examples/web-app/README.md
.vercel
