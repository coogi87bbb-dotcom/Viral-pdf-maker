rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    // isOwner() is derived from the verified Firebase Auth ID token, never from
    // client-supplied state (client JS can be edited/inspected; the token cannot).
    // Requires the account to have completed email verification so an attacker
    // can't self-register the owner's address and claim admin before it's verified.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'coogi87bbb@gmail.com';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Users ---
    // Each user can read/create their own profile. Only the profile's own
    // fields may be self-updated, and no one but the verified owner can ever
    // set role == 'admin' on any document (create or update).
    match /users/{userId} {
      allow read: if isSelf(userId) || isOwner();
      allow create: if isSelf(userId)
        && (request.resource.data.role == 'member' || isOwner());
      allow update: if (isSelf(userId) && request.resource.data.role == resource.data.role) || isOwner();
      allow delete: if isOwner();
    }

    // --- User-owned collections ---
    // Every document must carry a userId field set to the creator's uid;
    // only that user (or the owner) may read/modify/delete it.
    match /campaigns/{campaignId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /calendar_events/{eventId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /templates/{templateId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // --- Activity logs ---
    // Any signed-in user may append an entry about their own action; only the
    // owner can read the log (it's surfaced in the admin dashboard).
    match /activity_logs/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner();
      allow update, delete: if isOwner();
    }

    // --- System error memory ---
    // Real, persistent failure telemetry (src/lib/systemMemory.ts) — any
    // signed-in user's client can record/increment a failure signature
    // (it's app-health telemetry, not sensitive data, and multiple users
    // hitting the same bug need to accumulate into the same doc), but only
    // the owner can read the ledger back (surfaced in Master Admin).
    match /system_errors/{signature} {
      allow read: if isOwner();
      allow create, update: if isSignedIn();
      allow delete: if isOwner();
    }

    // --- Deal Closer usage analytics ---
    // Written by trackDealCloserUsage() (src/components/DealCloser/shared.tsx)
    // on every tool run; read by the owner-admin analytics panel. This
    // collection had no rule at all before — every write silently failed
    // under the "no catch-all" default-deny below (swallowed by that
    // function's best-effort try/catch, so it never surfaced as an error).
    match /dealCloserUsage/{toolId} {
      allow read: if isOwner();
      allow create, update: if isSignedIn();
    }

    // Same aggregate-analytics shape as dealCloserUsage above, for the
    // Contract Audit tool.
    match /contractAuditUsage/{useCase} {
      allow read: if isOwner();
      allow create, update: if isSignedIn();
    }

    // --- Contract Audit history ("My Audits") ---
    // Same user-owned-collection shape as campaigns/calendar_events/
    // templates above — every document carries a userId field set to the
    // creator's uid; only that user (or the owner) may read/modify/delete it.
    match /contractAudits/{docId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // No catch-all: anything not explicitly matched above is denied by default.
  }
}
